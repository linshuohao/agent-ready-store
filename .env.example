# Copy to .env; replace local credentials before use. Never commit .env.
POSTGRES_PASSWORD=replace-local-db-password
MCP_SERVICE_TOKEN=replace-with-random-local-token
WEB_PORT=3000
API_PUBLIC_PORT=3002
WEB_ORIGIN=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost:3002,127.0.0.1:3002

# Stable random 32-byte hex key; keep across restarts. Never commit the real value.
CART_ENCRYPTION_KEY=
# Explicit exception for local HTTP only; use true with HTTPS.
CART_COOKIE_SECURE=false
