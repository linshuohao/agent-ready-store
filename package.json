{
  "name": "agent-ready-store",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @store/contracts build && node scripts/local.mjs dev",
    "build": "node scripts/local.mjs build",
    "typecheck": "pnpm --filter @store/contracts build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "node scripts/local.mjs db:generate",
    "db:migrate": "node scripts/local.mjs db:migrate",
    "db:seed": "node scripts/local.mjs db:seed",
    "start": "node scripts/local.mjs start",
    "test:e2e": "playwright test",
    "dev:deps": "docker compose run --rm deps",
    "dev:docker": "pnpm dev:deps && docker compose up web api",
    "start:docker": "docker compose -f compose.yaml -f compose.production.yaml up web api",
    "build:apps": "pnpm --filter @store/contracts build && pnpm --filter @store/api build && pnpm --filter @store/mcp-app build && pnpm --filter @store/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "6.0.2",
    "vitest": "5.0.5",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.0.0"
  },
  "type": "module"
}
