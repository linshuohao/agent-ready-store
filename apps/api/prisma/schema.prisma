generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Inventory {
  productId String @id
  quantity  Int
}

model Cart {
  handoffIssuedAt    DateTime? @db.Timestamptz(3)
  checkoutEpoch      BigInt   @default(0)
  order              Order?
  purchaseReviews    PurchaseReview[]
  id                 String   @id @db.Uuid
  origin             String   @default("HUMAN")
  agentCreated       Boolean  @default(false)
  items              Json
  version            Int      @default(1)
  createdAt          DateTime @db.Timestamptz(3)
  createScope        String
  createRequestId    String   @db.Uuid
  createPayloadHash  String
  encryptedCartToken String

  @@unique([createScope, createRequestId])
}

model Order {
  id                 String   @id @db.Uuid
  cartId             String   @unique @db.Uuid
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Restrict)
  createdAt          DateTime @db.Timestamptz(3)
  cartVersion        Int
  purchaseHash       String
  catalogRevision    String
  pricingRuleVersion String
  origin             String
  snapshot           Json
}


model PurchaseReview {
  id                 String @id @db.Uuid
  cartId             String @db.Uuid
  cart               Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  prepareScope       String
  prepareRequestId   String @db.Uuid
  requestHash        String
  channel            String
  actorScope         String
  cartVersion        Int
  purchaseHash       String
  checkoutEpoch      BigInt
  summary            Json
  createdAt          DateTime @db.Timestamptz(3)
  expiresAt          DateTime @db.Timestamptz(3)
  cancelled          Boolean @default(false)

  @@unique([prepareScope, prepareRequestId])
  @@index([cartId])
}
