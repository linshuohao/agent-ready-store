{
  "name": "@store/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vitepress dev .generated --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vitepress build .generated && node scripts/check.mjs",
    "preview": "vitepress preview .generated --host 127.0.0.1",
    "check": "node --test scripts/source-links.test.mjs && node scripts/check.mjs --negative",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "markdown-it": "14.1.0",
    "mermaid": "11.16.1",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  }
}
